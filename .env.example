# PostgreSQL databases
USER_DB_NAME=user_db
USER_DB_USERNAME=shopcore_user
USER_DB_PASSWORD=shopcore_user

# User service authentication
JWT_ISSUER=shopcore-user-service
JWT_AUDIENCE=shopcore-api
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_KEY_ID=shopcore-user-rs256-v1
JWT_PRIVATE_KEY_LOCATION=file:./.local/jwt/private.pem
JWT_PUBLIC_KEY_LOCATION=file:./.local/jwt/public.pem
REFRESH_TOKEN_TTL=P7D
REFRESH_COOKIE_NAME=shopcore_refresh
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Strict
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

PRODUCT_DB_NAME=product_db
PRODUCT_DB_USERNAME=shopcore_product
PRODUCT_DB_PASSWORD=shopcore_product

ORDER_DB_NAME=order_db
ORDER_DB_USERNAME=shopcore_order
ORDER_DB_PASSWORD=shopcore_order

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USERNAME=shopcore_notification
NOTIFICATION_DB_PASSWORD=shopcore_notification

# RabbitMQ
RABBITMQ_USERNAME=shopcore
RABBITMQ_PASSWORD=shopcore
